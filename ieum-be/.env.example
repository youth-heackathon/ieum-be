# 이음수첩 백엔드 환경변수
# 로컬: 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 커밋하지 않음)
# 배포(Railway/Render): 파일 대신 대시보드 환경변수에 같은 이름으로 넣는다

# ── 서버 ──
PORT=8080
# 프론트 도메인. 여러 개면 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── DB: Supabase Postgres (서울 ap-northeast-2) ──
# 로컬에서 DB 없이 돌리려면 ./gradlew bootTestRun (Docker로 Postgres를 띄우고 아래 값은 무시)
# IPv4만 되는 호스팅(Render 등)은 Session pooler(포트 5432) 주소를 쓴다.
# Transaction pooler(6543)는 prepared statement가 깨지므로 쓰지 않는다.
DB_URL=jdbc:postgresql://localhost:5432/ieum
DB_USERNAME=postgres
DB_PASSWORD=

# ── 보안 ──
# IP 해시용 비밀값 (예: openssl rand -hex 32)
IP_HASH_SALT=

# ── Anthropic (정리·쉬운 말 / 처방전 OCR) ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_OCR_MODEL=claude-opus-5-5

# ── OpenAI Whisper (음성 → 글) ──
OPENAI_API_KEY=

# ── 공공데이터포털 data.go.kr (식약처 허가정보·e약은요) ──
DATA_GO_KR_API_KEY=
